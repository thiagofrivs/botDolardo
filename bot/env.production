# Variables de entorno para producción
# IMPORTANTE: Cambiar estos valores en Render

# Token del bot de Telegram (obligatorio)
TELEGRAM_TOKEN=tu_token_de_telegram_aqui

# Clave secreta para autenticación del dashboard (obligatorio)
API_SECRET_KEY=tu_clave_secreta_aqui

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000

# URL de la API de cotizaciones
API_BASE_URL=https://dolarapi.com/v1/ambito/dolares/oficial

# Configuración de producción
LOG_LEVEL=INFO
MAX_LOG_ENTRIES=1000
CHECK_INTERVAL=900
NODE_ENV=production
