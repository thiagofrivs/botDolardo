# Token del bot de Telegram (obligatorio)
TELEGRAM_TOKEN=1234567890:ABCDEFghijklmnopQRSTUVwxyz

# Clave secreta para autenticación del dashboard (obligatorio)
API_SECRET_KEY=mi_clave_secreta_muy_segura_123

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000

# URL de la API de cotizaciones (opcional)
API_BASE_URL=https://dolarapi.com/v1/ambito/dolares/oficial

# Nivel de logging (opcional)
LOG_LEVEL=INFO

# Máximo número de logs a mantener (opcional)
MAX_LOG_ENTRIES=1000

# Intervalo para verificar cotizaciones en segundos (opcional)
CHECK_INTERVAL=30

# Entorno de ejecución (opcional)
NODE_ENV=production
